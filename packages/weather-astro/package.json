{
  "name": "@loksly/weather-astro",
  "version": "0.1.0",
  "description": "Weather from Open-Meteo (no API key), moon phase and sunrise/sunset, with no dependencies and no drawing.",
  "type": "module",
  "license": "MIT",
  "author": "Loksly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loksly/aimonitor.git",
    "directory": "packages/weather-astro"
  },
  "keywords": [
    "weather",
    "open-meteo",
    "moon",
    "moon-phase",
    "sunrise",
    "sunset"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --conditions=source --import tsx --test 'src/**/*.test.ts'",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
