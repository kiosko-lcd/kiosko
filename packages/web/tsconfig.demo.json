{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "customConditions": ["source"],
    "resolveJsonModule": true,
    "paths": {
      "kiosko-plugin-*": ["./demo/plugin-types.d.ts"],
      "@loksly/trcc-client": ["./demo/trcc-client.d.ts"]
    }
  },
  "include": ["demo/**/*.ts", "panel3d/**/*.ts", "src/env.d.ts"]
}
