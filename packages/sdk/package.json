{
  "name": "@tessera/sdk",
  "version": "0.1.0",
  "description": "Plugin SDK for Tessera: define widgets, data sources and interludes for small always-on LCD panels.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1.65 <2",
    "@loksly/lcd-canvas-kit": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loksly/tessera.git",
    "directory": "packages/sdk"
  },
  "author": "Loksly"
}
