{
  "name": "@kiosko/core",
  "version": "0.2.0",
  "description": "Kiosko runtime: grid layout engine, plugin host, compositor and panel drivers.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "source": "./src/layout/index.ts",
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./model": {
      "source": "./src/config/model.ts",
      "types": "./dist/config/model.d.ts",
      "default": "./dist/config/model.js"
    },
    "./config": {
      "source": "./src/config/tools.ts",
      "types": "./dist/config/tools.d.ts",
      "default": "./dist/config/tools.js"
    }
  },
  "dependencies": {
    "@loksly/lcd-canvas-kit": "0.2.0",
    "@loksly/trcc-client": "0.2.0",
    "@loksly/usb-ly": "0.2.0",
    "@napi-rs/canvas": "^1.0.10",
    "@kiosko/sdk": "0.2.0",
    "dejavu-fonts-ttf": "^2.37.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiosko-lcd/kiosko.git",
    "directory": "packages/core"
  },
  "author": "Loksly",
  "engines": {
    "node": ">=22.18"
  }
}
