CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A new firmware has to prove itself (on the Wi-Fi, server up, 30 s) or the bootloader goes back.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_LWIP_MAX_SOCKETS=16

# Throughput for frames: a bigger receive window than lwIP's 5760 bytes.
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# The session: ChaCha20-Poly1305, HKDF, P-256 for SPAKE2 (hardware SHA and MPI on the C6).
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# JPEG: the ROM's TJpgDec, called directly (display.c), straight to the panel in bands.
CONFIG_LOG_COLORS=n

# Cooler (main/power.c): the CPU scales 80-160 MHz and light-sleeps when idle; the Wi-Fi
# uses modem sleep unless frames come fast. A USB host on the console keeps it awake
# (the USB-Serial/JTAG can't stay connected through light sleep on the C6).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# The time in each mode (light sleep among them): `sleepPct` in status.json, and the logs.
CONFIG_PM_PROFILING=y
# Light sleep's code lives in IRAM (~12 KB of the heap); the SPI ISR goes to flash to win
# some of it back (it only waits while the flash is written: an OTA, a setting saved).
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
