{
  "name": "kiosko-monorepo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Kiosko: a widget mosaic for small always-on USB LCD panels (Thermalright Trofeo Vision and friends), with a visual editor and plugins.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/agent-sessions",
    "packages/lcd-canvas-kit",
    "packages/trcc-client",
    "packages/usb-ly",
    "packages/weather-astro",
    "packages/sdk",
    "packages/core",
    "packages/server",
    "packages/web",
    "plugins/*",
    "../kiosko-plugins/*"
  ],
  "scripts": {
    "start": "node --conditions=source packages/server/src/cli.ts start",
    "dev": "npm run web:build && node --conditions=source packages/server/src/cli.ts start --open",
    "web:build": "node packages/web/build.mjs",
    "web:watch": "node packages/web/build.mjs --watch",
    "web:demo": "node packages/web/build.mjs --demo --out site/demo",
    "web:site": "node packages/web/build.mjs --site --out site",
    "check": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json && tsc -p packages/web/tsconfig.demo.json",
    "test": "node --conditions=source --test \"packages/*/src/**/*.test.ts\" \"plugins/*/src/**/*.test.ts\" \"packages/web/demo/*.test.ts\" \"packages/web/landing/*.test.ts\"",
    "gallery": "node --conditions=source packages/server/src/cli.ts gallery --out tmp/gallery",
    "build": "npm run web:build",
    "dist": "node scripts/build-dist.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "plugins:scaffold": "node --conditions=source scripts/scaffold-plugin-repos.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "ical.js": "^2.2.1",
    "typescript": "^5.9.3"
  }
}
